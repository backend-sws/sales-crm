                                        "format": "email",
                                        "example": "admin@salescrm.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Logged in successfully"
                    },
                    "422": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
