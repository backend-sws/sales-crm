{
    "openapi": "3.0.0",
    "info": {
        "title": "SalesCRM API v1 Documentation",
        "description": "Official RESTful API documentation for SalesCRM built with Laravel 13, Service-Interface architecture, and standardized response envelope.",
        "version": "1.0.0"
